{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/morfredus/morfPackages/schema/manifest.schema.json",
  "title": "morfPackages release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "version", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "commit", "target", "platform", "format"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "target": { "type": "string", "minLength": 1 },
          "platform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "arch"],
            "properties": {
              "os": { "type": "string", "minLength": 1 },
              "arch": { "type": "string", "minLength": 1 }
            }
          },
          "format": { "enum": ["deb", "zip", "bin", "appimage"] },
          "built_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
